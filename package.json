{
  "name": "ai-snap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "jscpd": "jscpd --min-lines 5 --min-tokens 50 src/"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "jscpd": "^4.0.5",
    "prettier": "^3.6.2",
    "terser": "^5.36.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "@types/simple-peer": "^9.11.9",
    "buffer": "^6.0.3",
    "colyseus.js": "^0.16.22",
    "events": "^3.3.0",
    "postprocessing": "^6.37.8",
    "process": "^0.11.10",
    "simple-peer": "^9.11.1",
    "three": "^0.180.0"
  }
}
