{
  "name": "ai-snap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "biome lint src",
    "lint:fix": "biome lint src --write",
    "format": "biome format src --write",
    "check": "biome check src",
    "check:fix": "biome check src --write",
    "jscpd": "jscpd --min-lines 5 --min-tokens 50 src/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/three": "^0.180.0",
    "jscpd": "^4.0.5",
    "terser": "^5.36.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "@types/simple-peer": "^9.11.9",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "process": "^0.11.10",
    "simple-peer": "^9.11.1",
    "three": "^0.180.0"
  }
}
